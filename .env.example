# Copy to .env and fill in. Never commit .env.

# --- apps/web ---
# Which chain the web app talks to. `?chain=...` in the URL overrides it at run time.
#   mock            the whole game in memory, no chain (default)
#   sepolia         the live contract on the Sepolia testnet, with a browser wallet
#   mainnet         not deployed yet: runs Sepolia (needs the relayer API-key proxy once it is, see docs/ZAMA_NOTES.md)
# Announced, not implemented yet: the app says so in its footer and runs the mock.
#   solana-devnet   Solana, once Zama ships SVM support (see docs/SOLANA_PORTING.md)
#   solana-mainnet
VITE_CHAIN_MODE=mock
# Comma-separated host names that run the mock whatever VITE_CHAIN_MODE says, so one
# deployment can serve a demo domain next to the live one. `?chain=...` still wins.
VITE_MOCK_HOSTS=
# Read endpoint for the browser. Must allow cross-origin requests. Defaults to a public one.
# This value is shipped to the browser: do not put a secret key in it.
VITE_SEPOLIA_RPC_URL=
# Optional: pins Sepolia's gas price, in wei (e.g. 20000000 = 0.02 gwei), when its fees sit far
# below the wallets' default tip and a deploy would ask for more ETH than the deployer holds.
SEPOLIA_GAS_PRICE=
# Overrides the committed DoNotOpen address (packages/chain-adapter/src/evm/deployments).
VITE_DNO_ADDRESS=
# The backend (apps/api): box lists, leaderboard, duels and receipts come from its index
# instead of the RPC. Empty: everything is read from the RPC, as before.
VITE_API_URL=
# Send encryptions and decryptions through the API's relayer proxy (VITE_API_URL + /relayer)
# instead of straight to Zama's relayer. Required on mainnet, where the relayer needs the
# collection's API key and bills it: the proxy holds the key and meters each wallet.
VITE_RELAYER_PROXY=false
# Reown (WalletConnect) project id, from https://cloud.reown.com. Lets phones, which have no
# wallet extension, connect through a wallet app. Public by design; add the site's domains to
# the project's allowlist. Empty: only wallets injected in the browser are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# --- apps/api (server side only, never VITE_) ---
# Google's Gemini API key for the manual's chatbot, from https://aistudio.google.com/apikey.
# Keep the Google project without billing: the free tier then can never cost anything. Empty:
# the chat quotes the manual's paragraphs instead of answering.
GEMINI_API_KEY=

# Signs the token images the API stores on Arweave through ArDrive's Turbo (free under 100 KiB,
# and the SVGs are about 3 KB). A fresh Ethereum key made for this only, never a wallet with
# funds: it pays nothing, it only shows who uploaded. Empty: images stay served by the API.
ARWEAVE_KEY=

# The collection's Discord channel, posted from the chain. rehearse: written and kept, never sent,
# readable at GET /v1/herald; live: sent through the channel's webhook (channel settings,
# Integrations, Webhooks); off (default): nothing.
HERALD_DISCORD=off
DISCORD_WEBHOOK_URL=
# Also post what happens under encryption (🔒 mints, shakes, pets, meals), beside the reveals (🔓).
HERALD_DISCORD_SEALED=true
HERALD_BOX_URL=
# The daily lesson on how the game works, worded by Gemini from the manual (UTC hour, -1: none),
# and the manual page it links to, e.g. https://<site>/docs.
HERALD_LESSON_HOUR_UTC=14
HERALD_MANUAL_URL=
HERALD_ADMIN_TOKEN=
# The team's private channel (the monitoring one will do): each step a player takes on the
# boarding page and the whitelist, as it happens, with their X handle. Unset: nothing is told.
ACTIVITY_DISCORD_WEBHOOK_URL=
# The team's admin site (apps/admin) under /admin: one password, 16 characters or more. Unset:
# nothing is served there. On the server, ADMIN_DOMAIN (e.g. admin.do-not-open.app) routes it.
ADMIN_PASSWORD=
# The team's own wallets, comma-separated: never a place on the list. Unset: the deployer only (an
# empty value would leave nobody out).
# TEAM_WALLETS=0x590891F269720001435004A1089cAB5b2c20029A,0x...
ADMIN_DOMAIN=
# The mainnet allow list: its seats, first come, first served (the spec's 1500 when unset: one per X
# account or wallet, GET /v1/seats counts them), and the token that reads the whole list
# (GET /v1/allowlist?token=, at least 16 characters; unset: nobody can).
ALLOW_LIST_PLACES=
ALLOW_LIST_ADMIN_TOKEN=
# The frozen whitelist's gift tree, the JSON GET /v1/allowlist/gifts?token= returned when the list
# closed (the file whose root is on WhitelistGifts): GET /v1/gifts/:address serves its proofs.
WHITELIST_GIFTS_TREE=
# Sign in with X for the home page's boarding pass: the OAuth 2.0 client of an app on
# developer.x.com (User authentication settings: OAuth 2.0, Web App, callback
# https://<API_DOMAIN>/v1/xpass/x/callback, website https://do-not-open.app). Server-side only.
# Without X_CLIENT_ID, players prove their X account with a post carrying their pass code.
X_CLIENT_ID=
X_CLIENT_SECRET=
# The announcement post on X players like, reply to and repost (the digits at the end of its
# link). Unset: those three tasks wait, and a seat needs only the X account, the follow and the post.
X_ANNOUNCEMENT_ID=
# Where X may send players back after signing in (default: the site, its testnet, localhost:5173).
# X_RETURN_ORIGINS=https://do-not-open.app,https://testnet.do-not-open.app
# The manual's chatbot as /ask on Discord: the application's id and public key (Developer Portal,
# General Information). The bot token only registers the command (pnpm --filter @dno/api
# discord:commands); the API never needs it. DISCORD_MANUAL_URL defaults to HERALD_MANUAL_URL.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_MANUAL_URL=
# The collection's server id (right-click the server, Copy Server ID). With the application above,
# the boarding page asks players to join it and run /board there, for whitelist points.
DISCORD_GUILD_ID=

# The studio: cats drawn from a prompt by fal.ai (https://fal.ai/dashboard/keys), paid for out of
# packs bought on-chain in USDC (StudioPacks). Empty: the studio is off. The key bills real
# dollars, so the API stops at STUDIO_DAILY_BUDGET_USD a day (estimated, every account together).
# On Sepolia packs are paid in test USDC: list the testers who may generate in STUDIO_ALLOWLIST
# (comma-separated addresses) and keep the budget small. STUDIO_PAUSED=true closes it at once.
FAL_KEY=
STUDIO_DAILY_BUDGET_USD=20
STUDIO_ALLOWLIST=
STUDIO_PAUSED=false
# Failed generations an account gets its unit back for per day; past it a failure keeps its unit.
STUDIO_REFUNDS_PER_DAY=3
# STUDIO_IMAGE_MODEL=fal-ai/flux/schnell
# STUDIO_3D_MODEL=tripo3d/h3.1/image-to-3d
# STUDIO_CUTOUT_MODEL=fal-ai/birefnet
# STUDIO_TIMEOUT_MS=600000

# The depot's rats. The attester signs the adoption of AI rats once their picture is on Arweave
# (shrunk to a free upload, like the cats'; the 3D model stays with the API): a fresh key made for
# this only, whose address is RATS_ATTESTER when the contracts are deployed. Empty: only seed rats
# can be adopted.
RATS_ATTESTER_KEY=
# The site, for the rats' metadata (external_url), e.g. https://do-not-open.app
SITE_URL=

# --- packages/contracts-evm ---
# Deployer account: set ONE of the two. Use a throwaway testnet wallet.
MNEMONIC=
PRIVATE_KEY=
# Defaults to a public Sepolia RPC when empty. A private endpoint is more reliable.
SEPOLIA_RPC_URL=
# Only needed for `pnpm verify:sepolia`.
ETHERSCAN_API_KEY=
# Optional deployment parameters (defaults shown), in USDC. Each can also be paid in cUSDC.
MINT_PRICE_USDC=5
OBSERVE_FEE_USDC=1
FEED_FEE_USDC=0.5
PAID_SHAKE_FEE_USDC=2.5
# Owner of the collection (withdrawals, base URI), the treasury and the owner of the
# LiquidityLocker. Defaults to the deployer. It is a constructor argument: changing it (or
# leaving it unset after a deploy that set it) makes the next deploy redeploy DoNotOpen.
COLLECTION_OWNER=
# The CROQ market: a Uniswap V3 position holding only CROQ (no USDC from the deployer),
# locked for good in the LiquidityLocker. USDC per CROQ where it starts (the lowest price
# CROQ ever sells at, rounded up to a tick), how many times higher it ends, and the fee
# tier in hundredths of a bip (10000 = 1%).
LIQUIDITY_START_PRICE=0.001
LIQUIDITY_RANGE=1000
LIQUIDITY_FEE=10000
# Decryption credits (DecryptionCredits), bought in plain USDC past the free daily allowance.
# One credit is one unit: a decrypted value (an encrypted input costs 5). Either a fixed price,
# or Zama's dollar price for one decryption on the collection's plan times a margin.
CREDIT_PRICE_USDC=0.01
# ZAMA_DECRYPT_USD=0.001
# CREDIT_MARGIN=2
# Where credit payments go. Defaults to COLLECTION_OWNER.
CREDITS_TREASURY=
# Whose cUSDC pays the 30% sniff rebate of power-1 rats (RatTricks). It must make RatTricks its
# cUSDC operator; on a test network the deploy does it when this is the deployer. Defaults to
# COLLECTION_OWNER.
TRICKS_REBATER=
