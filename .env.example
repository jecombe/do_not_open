# Copy to .env and fill in. Never commit .env.

# --- apps/web ---
# Which chain the web app talks to. `?chain=...` in the URL overrides it at run time.
#   mock            the whole game in memory, no chain (default)
#   sepolia         the live contract on the Sepolia testnet, with a browser wallet
# Announced, not implemented yet: the app says so in its footer and runs the mock.
#   mainnet         Ethereum mainnet (needs the relayer API-key proxy, see docs/ZAMA_NOTES.md)
#   solana-devnet   Solana, once Zama ships SVM support (see docs/SOLANA_PORTING.md)
#   solana-mainnet
VITE_CHAIN_MODE=mock
# Comma-separated host names that run the mock whatever VITE_CHAIN_MODE says, so one
# deployment can serve a demo domain next to the live one. `?chain=...` still wins.
VITE_MOCK_HOSTS=
# Read endpoint for the browser. Must allow cross-origin requests. Defaults to a public one.
# This value is shipped to the browser: do not put a secret key in it.
VITE_SEPOLIA_RPC_URL=
# Privy app id (dashboard.privy.io): sign in with e-mail, a social account or any wallet.
# Public by design. Leave empty to use the browser's injected wallet. The Privy app
# secret is for servers only: it never belongs here.
VITE_PRIVY_APP_ID=
# Overrides the committed DoNotOpen address (packages/chain-adapter/src/evm/deployments).
VITE_DNO_ADDRESS=

# --- packages/contracts-evm ---
# Deployer account: set ONE of the two. Use a throwaway testnet wallet.
MNEMONIC=
PRIVATE_KEY=
# Defaults to a public Sepolia RPC when empty. A private endpoint is more reliable.
SEPOLIA_RPC_URL=
# Only needed for `pnpm verify:sepolia`.
ETHERSCAN_API_KEY=
# Optional deployment parameters (defaults shown).
MINT_PRICE_ETH=0.002
OBSERVE_FEE_ETH=0.0005
FEED_FEE_ETH=0.0002
PAID_SHAKE_FEE_ETH=0.001
# Owner of the collection (withdrawals, base URI). Defaults to the deployer.
COLLECTION_OWNER=
