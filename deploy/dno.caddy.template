# DO NOT OPEN API. Rendered by deploy.sh into /opt/edge/sites/dno.caddy: the site address is
# API_DOMAIN followed by API_ALIASES from the server's .env. Caddy gets a certificate for each
# name and redirects plain HTTP to HTTPS.
__API_HOSTS__ {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Prometheus' scrape path: read over the Docker network only (deploy/monitoring).
	@metrics path /metrics
	respond @metrics 404
	# The team's admin site: only through its own domain (dno-admin.caddy.template).
	@admin path /admin /admin/*
	respond @admin 404
	# Every replica of the API, as Docker's DNS lists them under the alias, looked up again every
	# 2 s so a deploy's new replicas join quickly. One client IP always reaches the same replica:
	# its rate limit and chat quota, counted in that process, stay exact. A replica that refuses
	# connections (stopped by a deploy) is left out for 30 s and the request tries another one.
	# Active health checks do not run on dynamic upstreams: deploy.sh checks each replica itself.
	reverse_proxy {
		dynamic a dno-api 8080 {
			refresh 2s
		}
		lb_policy client_ip_hash
		lb_try_duration 5s
		fail_duration 30s
	}
}
