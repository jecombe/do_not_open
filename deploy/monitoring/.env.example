# Copy to /opt/dno/monitoring/.env on the server; deploy.sh starts the monitoring once it exists.
# Grafana's address (an A record to the server) and its admin account.
MONITORING_DOMAIN=monitoring.do-not-open.app
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# A webhook of a private Discord channel (channel settings, Integrations, Webhooks), for alerts.
ALERT_DISCORD_WEBHOOK_URL=
# How long Prometheus keeps the series (capped at 5 GB anyway).
PROMETHEUS_RETENTION=90d
