{
  "name": "@dno/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsx scripts/prerender.mts",
    "prerender": "tsx scripts/prerender.mts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render:metadata": "tsx scripts/render-metadata.cts",
    "render:og": "tsx scripts/render-og.cts",
    "export:manual": "tsx scripts/export-manual.mts",
    "test": "tsx scripts/export-manual.mts --check"
  },
  "dependencies": {
    "@dno/chain-adapter": "workspace:*",
    "@dno/game-spec": "workspace:*",
    "@dno/generator": "workspace:*",
    "@dno/scene": "workspace:*",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/stardos-stencil": "^5.2.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@vercel/analytics": "^2.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.55.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
