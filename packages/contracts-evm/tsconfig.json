{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": ["node_modules"],
  "files": ["./hardhat.config.ts"],
  "include": ["lib/**/*", "tasks/**/*", "test/**/*", "deploy/**/*", "types/"]
}
