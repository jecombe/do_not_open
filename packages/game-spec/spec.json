    "goldenScoreBonus": 250
  },
  "mechanics": {
    "mint": {
      "paid": true,
      "maxPerTx": 10,
      "rule": "Draw one 64-bit encrypted seed per box. Derive stateRoll and the five trait rolls from the seed layout, compute state and rarityScore. Only the program may compute on these values: the holder gets NO blanket decryption right, otherwise shake and observe would be pointless."
    },
    "shake": {
      "paid": false,
      "caller": "holder",
      "rule": "The program picks one of the five traits with an encrypted uniform draw and grants the holder a private decryption of two fresh values: the picked trait's seed offset and its roll. Never reveals state or rarityScore. Unlimited."
    },
    "observe": {
      "paid": true,
      "caller": "holder",
      "irreversible": true,
      "rule": "Two steps. Request: the seed becomes publicly decryptable. Finalise: anyone submits the decrypted seed with its proof; the program verifies it, derives state, traits and score in the clear, and stores them. Entangled partner is observed too."
    },
    "proveAlive": {
      "paid": false,
      "caller": "holder",
      "rule": "Two steps, once per box. Request: computes the single encrypted bit (state == alive) and makes it publicly decryptable. Finalise: anyone submits the verified bit. If true, grants the Vet Certified badge. Nothing else leaks; the bit is public whichever way it falls."
    },
    "duel": {
      "paid": false,
      "caller": "both holders (two-step: challenge, accept)",
      "rule": "Challenge, accept, finalise. Accepting computes three encrypted values and makes them publicly decryptable: the bit (scoreA > scoreB), a uniformly picked trait offset, and the loser's roll for that trait. Ties go to B (the challenged box). Winner's win counter increments. The loser's picked trait becomes public, never the state."
    },
    "entangle": {
      "paid": false,
      "caller": "both holders (two-step: propose, accept)",
      "rule": "Links two unrevealed boxes. A box has at most one partner. Observing one observes the other."
    },
    "feed": {
      "paid": true,
      "caller": "anyone",
      "rule": "Adds an encrypted uniform amount between perFeedMin and perFeedMax to the encrypted affection counter. Cats are fickle: the number of feeds is public, the affection it earned is not. Sealed boxes only."
    },
    "paidShake": {
      "paid": true,
      "caller": "anyone but the holder",
      "holderShareBps": 7000,
      "rule": "Same trait pick as shake, but the decryption right goes to the payer only. 70% of the fee goes to the holder."
    }
  },
  "events": {
    "Minted": { "fields": ["tokenId", "owner"] },
    "Shaken": { "fields": ["tokenId", "viewer", "paid"], "note": "The trait index is NOT emitted; it stays encrypted-side knowledge of the viewer." },
    "ObserveRequested": { "fields": ["tokenId"] },
    "Observed": { "fields": ["tokenId", "seed", "state", "rarityScore", "golden"] },
    "AliveCheckRequested": { "fields": ["tokenId", "aliveHandle"] },
    "AliveProven": { "fields": ["tokenId", "alive"] },
    "DuelChallenged": { "fields": ["duelId", "tokenIdA", "tokenIdB"] },
    "DuelAccepted": { "fields": ["duelId"] },
    "DuelCancelled": { "fields": ["duelId"] },
    "DuelResolved": { "fields": ["duelId", "winnerTokenId", "loserTokenId", "revealedTraitIndex", "revealedTraitRoll"] },
    "EntangleProposed": { "fields": ["tokenIdA", "tokenIdB"] },
    "Entangled": { "fields": ["tokenIdA", "tokenIdB"] },
    "Fed": { "fields": ["tokenId", "feeder"] }
  }
